# Execution mode: "local" (stdio) or "server" (HTTP)
MODE=local

# Meta app credentials (never commit real values)
META_APP_ID=
META_APP_SECRET=

# 32-byte key, base64 encoded, used to encrypt access tokens at rest.
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# SQLite database path
DATABASE_PATH=./data/unofficial-instagram-mcp.sqlite

# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
